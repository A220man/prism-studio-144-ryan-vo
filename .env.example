# Prism Studio - Visual Guide to Claude Code
# Environment Configuration
# Copy to .env and fill in your values

# Application
APP_NAME=Prism Studio
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite+aiosqlite:///./prism.db

# Security
SECRET_KEY=dev-secret-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Keycloak (OIDC)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=prism-studio
KEYCLOAK_CLIENT_ID=prism-frontend
KEYCLOAK_CLIENT_SECRET=secret

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# LLM (optional - for opt-in explanations)
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=